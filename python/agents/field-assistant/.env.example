# Copy to .env for local testing:  cp .env.example .env
# Get a key at https://aistudio.google.com/apikey (used for card scanning and Ask)
GOOGLE_API_KEY=
# Local testing: JSON files in ./data and no sign-in
DATA_BACKEND=local
AUTH_MODE=none
LOCAL_USER=me@example.com
FIELD_MODEL=gemini-2.5-flash
FIELD_TIMEZONE=America/New_York
