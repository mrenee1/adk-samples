# Cloud Run settings. Copy to env.yaml, fill in, then deploy (see README).
DATA_BACKEND: firestore
AUTH_MODE: firebase
GOOGLE_GENAI_USE_VERTEXAI: "TRUE"
GOOGLE_CLOUD_PROJECT: YOUR-PROJECT
GOOGLE_CLOUD_LOCATION: us-east1
FIELD_MODEL: gemini-2.5-flash
FIELD_TIMEZONE: America/New_York
# Who may sign in (comma separated)
ALLOWED_EMAILS: you@company.com,rep@company.com
# Firebase console > Project settings > Your apps > Web app > config (as JSON)
FIREBASE_WEB_CONFIG: '{"apiKey":"...","authDomain":"YOUR-PROJECT.firebaseapp.com","projectId":"YOUR-PROJECT","appId":"..."}'
